            {
              "id": "CMD-002",
              "name": "os.system / os.popen call",
              "shortDescription": {
                "text": "os.system / os.popen call"
              },
              "help": {
                "text": "Use subprocess.run([...]) with an argument list."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "DES-001",
              "name": "Unsafe deserialization (pickle)",
              "shortDescription": {
                "text": "Unsafe deserialization (pickle)"
              },
              "help": {
                "text": "Use JSON or another data-only format."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-004",
              "name": "API key (sk-...)",
              "shortDescription": {
                "text": "API key (sk-...)"
              },
              "help": {
                "text": "Move it to an env var and rotate the key."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-005",
              "name": "Hardcoded secret-looking value",
              "shortDescription": {
                "text": "Hardcoded secret-looking value"
              },
              "help": {
                "text": "Load it from the environment at runtime."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "NET-001",
              "name": "Outbound network access",
              "shortDescription": {
                "text": "Outbound network access"
              },
              "help": {
                "text": "Restrict to an allowlist of hosts and document it."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
